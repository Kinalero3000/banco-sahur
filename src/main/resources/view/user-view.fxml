<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #16305F;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>

      <Pane layoutX="63.0" prefHeight="720.0" prefWidth="1162.0" style="-fx-background-color: #F7FAFD;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="63.0" AnchorPane.rightAnchor="55.0" AnchorPane.topAnchor="0.0">
         <children>

            <Label layoutX="40.0" layoutY="20.0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #16305F;" text="Gestión de Usuarios" />

            <!-- Formulario -->
            <Label layoutX="40.0" layoutY="80.0" style="-fx-font-weight: bold; -fx-text-fill: #16305F;" text="Nombre" />
            <TextField fx:id="txtFieldName" layoutX="40.0" layoutY="100.0" prefWidth="230.0" promptText="Nombre" style="-fx-background-color: #EEF3FA; -fx-background-radius: 10; -fx-border-color: #1E4E8C; -fx-border-radius: 10; -fx-padding: 6;" />

            <Label layoutX="40.0" layoutY="140.0" style="-fx-font-weight: bold; -fx-text-fill: #16305F;" text="Apellido" />
            <TextField fx:id="txtFieldLastName" layoutX="40.0" layoutY="160.0" prefWidth="230.0" promptText="Apellido" style="-fx-background-color: #EEF3FA; -fx-background-radius: 10; -fx-border-color: #1E4E8C; -fx-border-radius: 10; -fx-padding: 6;" />

            <Label layoutX="40.0" layoutY="200.0" style="-fx-font-weight: bold; -fx-text-fill: #16305F;" text="Correo" />
            <TextField fx:id="txtFieldEmail" layoutX="40.0" layoutY="220.0" prefWidth="230.0" promptText="correo@ejemplo.com" style="-fx-background-color: #EEF3FA; -fx-background-radius: 10; -fx-border-color: #1E4E8C; -fx-border-radius: 10; -fx-padding: 6;" />

            <Label layoutX="40.0" layoutY="260.0" style="-fx-font-weight: bold; -fx-text-fill: #16305F;" text="Contraseña" />
            <PasswordField fx:id="txtFieldPassword" layoutX="40.0" layoutY="280.0" prefWidth="230.0" promptText="Contraseña" style="-fx-background-color: #EEF3FA; -fx-background-radius: 10; -fx-border-color: #1E4E8C; -fx-border-radius: 10; -fx-padding: 6;" />

            <Label layoutX="40.0" layoutY="320.0" style="-fx-font-weight: bold; -fx-text-fill: #16305F;" text="Confirmar contraseña" />
            <PasswordField fx:id="txtFieldConfirmPassword" layoutX="40.0" layoutY="340.0" prefWidth="230.0" promptText="Confirmar contraseña" style="-fx-background-color: #EEF3FA; -fx-background-radius: 10; -fx-border-color: #1E4E8C; -fx-border-radius: 10; -fx-padding: 6;" />

            <Label layoutX="40.0" layoutY="380.0" style="-fx-font-weight: bold; -fx-text-fill: #16305F;" text="Rol" />
            <ComboBox fx:id="comboBoxRol" layoutX="40.0" layoutY="400.0" prefWidth="230.0" promptText="Selecciona un rol" />

            <!-- Botones -->
            <Button fx:id="btnAgregar" layoutX="40.0" layoutY="450.0" mnemonicParsing="false" onAction="#handleAgregar" prefWidth="105.0" style="-fx-background-color: #16305F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="Agregar" />
            <Button fx:id="btnActualizar" layoutX="165.0" layoutY="450.0" mnemonicParsing="false" onAction="#handleActualizar" prefWidth="105.0" style="-fx-background-color: #1E4E8C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="Actualizar" />

            <Button fx:id="btnEliminar" layoutX="40.0" layoutY="490.0" mnemonicParsing="false" onAction="#handleEliminar" prefWidth="105.0" style="-fx-background-color: #B23B3B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="Eliminar" />
            <Button fx:id="btnLimpiar" layoutX="165.0" layoutY="490.0" mnemonicParsing="false" onAction="#handleLimpiar" prefWidth="105.0" style="-fx-background-color: #8A94A6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="Limpiar" />

            <Button fx:id="btnMostrarTodos" layoutX="40.0" layoutY="530.0" mnemonicParsing="false" onAction="#handleMostrarTodos" prefWidth="230.0" style="-fx-background-color: #16305F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="Mostrar Todos" />

            <!-- Tabla -->
            <TableView fx:id="tableUsers" layoutX="320.0" layoutY="78.0" prefHeight="602.0" prefWidth="827.0">
              <columns>
                <TableColumn fx:id="colUserID" prefWidth="180.0" text="ID Usuario" />
                <TableColumn fx:id="colName" prefWidth="150.0" text="Nombre" />
                <TableColumn fx:id="colLastName" prefWidth="150.0" text="Apellido" />
                <TableColumn fx:id="colEmail" prefWidth="184.0" text="Correo" />
                <TableColumn fx:id="colRolID" prefWidth="161.0" text="ID Rol" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

         </children>
      </Pane>

   </children>
</AnchorPane>
