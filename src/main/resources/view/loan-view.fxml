<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: linear-gradient(to bottom right, #16305F, #1E4E8C);" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>

      <!-- Tarjeta blanca centrada, mismo estilo que login-view -->
      <VBox layoutX="28.0" layoutY="7.0" prefHeight="749.0" prefWidth="1235.0" spacing="18.0" style="-fx-background-color: #F7FAFD; -fx-background-radius: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 20, 0, 0, 4);">
         <padding>
            <javafx.geometry.Insets bottom="24.0" left="32.0" right="32.0" top="24.0" />
         </padding>
         <children>

            <Label fx:id="lblTitulo" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #16305F;" text="Gestión de Préstamos" />
            <Button mnemonicParsing="false" onAction="#handleVolverDashboard" styleClass="btn-primary" stylesheets="@../css/button-design.css" text="Volver" />

            <HBox spacing="28.0" VBox.vgrow="ALWAYS">
               <children>

                  <!-- Formulario (se oculta cuando un Cliente entra en modo solo-lectura) -->
                  <VBox fx:id="formBox" prefWidth="300.0" spacing="10.0">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #16305F;" text="ID Préstamo" />
                        <TextField fx:id="txtIdLoan" promptText="Ej. P001" style="-fx-background-color: #EEF3FA; -fx-background-radius: 10; -fx-border-color: #1E4E8C; -fx-border-radius: 10; -fx-padding: 8;" />

                        <Label style="-fx-font-weight: bold; -fx-text-fill: #16305F;" text="ID Cliente" />
                        <TextField fx:id="txtIdClient" promptText="Ej. C001" style="-fx-background-color: #EEF3FA; -fx-background-radius: 10; -fx-border-color: #1E4E8C; -fx-border-radius: 10; -fx-padding: 8;" />

                        <Label style="-fx-font-weight: bold; -fx-text-fill: #16305F;" text="Tipo de Crédito" />
                        <TextField fx:id="txtIdTypeCredit" promptText="Ej. 1" style="-fx-background-color: #EEF3FA; -fx-background-radius: 10; -fx-border-color: #1E4E8C; -fx-border-radius: 10; -fx-padding: 8;" />

                        <Label style="-fx-font-weight: bold; -fx-text-fill: #16305F;" text="Monto" />
                        <TextField fx:id="txtAmount" promptText="Ej. 5000.00" style="-fx-background-color: #EEF3FA; -fx-background-radius: 10; -fx-border-color: #1E4E8C; -fx-border-radius: 10; -fx-padding: 8;" />

                        <Label style="-fx-font-weight: bold; -fx-text-fill: #16305F;" text="Tasa de Interés" />
                        <TextField fx:id="txtInterestRate" promptText="Ej. 12" style="-fx-background-color: #EEF3FA; -fx-background-radius: 10; -fx-border-color: #1E4E8C; -fx-border-radius: 10; -fx-padding: 8;" />

                        <Label style="-fx-font-weight: bold; -fx-text-fill: #16305F;" text="Plazo (meses)" />
                        <TextField fx:id="txtThermMonths" promptText="Ej. 24" style="-fx-background-color: #EEF3FA; -fx-background-radius: 10; -fx-border-color: #1E4E8C; -fx-border-radius: 10; -fx-padding: 8;" />

                        <Label style="-fx-font-weight: bold; -fx-text-fill: #16305F;" text="Estado" />
                        <Label fx:id="lblStatus" style="-fx-text-fill: #1E4E8C;" text="—" />

                        <HBox spacing="8.0">
                           <children>
                              <Button fx:id="btnAgregar" mnemonicParsing="false" onAction="#handleAgregar" style="-fx-background-color: #16305F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 14;" text="Agregar" />
                              <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#handleActualizar" style="-fx-background-color: #1E4E8C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 14;" text="Actualizar" />
                           </children>
                        </HBox>

                        <HBox spacing="8.0">
                           <children>
                              <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#handleEliminar" style="-fx-background-color: #B23B3B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 14;" text="Eliminar" />
                              <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#handleLimpiar" style="-fx-background-color: #8A94A6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 14;" text="Limpiar" />
                           </children>
                        </HBox>

                        <HBox spacing="8.0">
                           <children>
                              <Button fx:id="btnAprobar" mnemonicParsing="false" onAction="#handleAprobar" style="-fx-background-color: #2E7D4F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 14;" text="Aprobar" />
                              <Button fx:id="btnRechazar" mnemonicParsing="false" onAction="#handleRechazar" style="-fx-background-color: #C77A1E; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 14;" text="Rechazar" />
                           </children>
                        </HBox>

                        <Button fx:id="btnMostrarTodos" mnemonicParsing="false" onAction="#handleMostrarTodos" style="-fx-background-color: #16305F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 14;" text="Mostrar Todos" />
                     </children>
                  </VBox>

                  <!-- Tabla -->
                  <TableView fx:id="tableLoans" prefHeight="480.0" styleClass="dashboard-table" stylesheets="@../css/dashboard-design.css" HBox.hgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colIdLoan" prefWidth="80.0" text="ID Préstamo" />
                        <TableColumn fx:id="colIdClient" prefWidth="80.0" text="ID Cliente" />
                        <TableColumn fx:id="colIdTypeCredit" prefWidth="80.0" text="Tipo Crédito" />
                        <TableColumn fx:id="colAmount" prefWidth="80.0" text="Monto" />
                        <TableColumn fx:id="colInterestRate" prefWidth="70.0" text="Interés" />
                        <TableColumn fx:id="colThermMonths" prefWidth="70.0" text="Meses" />
                        <TableColumn fx:id="colRequestDate" prefWidth="100.0" text="Fecha Solicitud" />
                        <TableColumn fx:id="colApprovalDate" prefWidth="100.0" text="Fecha Aprobación" />
                        <TableColumn fx:id="colStatus" prefWidth="80.0" text="Estado" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>

               </children>
            </HBox>

         </children>
      </VBox>

   </children>
</AnchorPane>
