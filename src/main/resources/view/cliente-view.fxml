<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<Pane prefHeight="720.0" prefWidth="1280.0" styleClass="root" stylesheets="@../css/dashboard-design.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.jgunzalesindustries.banco.sahur.controller.ClienteController">

    <BorderPane layoutX="56.0" layoutY="0" prefHeight="720.0" prefWidth="1172.0" styleClass="dashboard-container">
        <top>
            <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-padding: 16;" styleClass="card-title" text="Gestión de Clientes" />
        </top>

        <left>
            <VBox prefHeight="670.0" prefWidth="420.0" spacing="16" style="-fx-padding: 20;">
                <GridPane hgap="12" vgap="14">
                    <Label style="-fx-font-size: 15px;" styleClass="dashboard-label" text="DPI:" />
                    <TextField fx:id="dpiField" prefHeight="36.0" prefWidth="240.0" style="-fx-font-size: 14px;" styleClass="dashboard-field" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label style="-fx-font-size: 15px;" styleClass="dashboard-label" text="Nombre:" GridPane.rowIndex="1" />
                    <TextField fx:id="firstNameField" prefHeight="36.0" prefWidth="240.0" style="-fx-font-size: 14px;" styleClass="dashboard-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label style="-fx-font-size: 15px;" styleClass="dashboard-label" text="Apellido:" GridPane.rowIndex="2" />
                    <TextField fx:id="lastNameField" prefHeight="36.0" prefWidth="240.0" style="-fx-font-size: 14px;" styleClass="dashboard-field" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label style="-fx-font-size: 15px;" styleClass="dashboard-label" text="Teléfono:" GridPane.rowIndex="3" />
                    <TextField fx:id="phoneField" prefHeight="36.0" prefWidth="240.0" style="-fx-font-size: 14px;" styleClass="dashboard-field" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label style="-fx-font-size: 15px;" styleClass="dashboard-label" text="Correo:" GridPane.rowIndex="4" />
                    <TextField fx:id="emailField" prefHeight="36.0" prefWidth="240.0" style="-fx-font-size: 14px;" styleClass="dashboard-field" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                    <Label style="-fx-font-size: 15px;" styleClass="dashboard-label" text="Dirección:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                    <TextField fx:id="addressField" prefHeight="36.0" prefWidth="240.0" style="-fx-font-size: 14px;" styleClass="dashboard-field" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                    <columnConstraints>
                        <ColumnConstraints minWidth="90.0" />
                        <ColumnConstraints />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="46.0" />
                        <RowConstraints minHeight="46.0" />
                        <RowConstraints minHeight="46.0" />
                        <RowConstraints minHeight="46.0" />
                        <RowConstraints minHeight="46.0" />
                        <RowConstraints minHeight="46.0" />
                    </rowConstraints>
                </GridPane>

                <HBox spacing="14">
                    <Button onAction="#onSave" prefHeight="38.0" prefWidth="100.0" style="-fx-font-size: 14px;" styleClass="btn-create" stylesheets="@../css/button-design.css" text="Guardar" />
                    <Button onAction="#onDelete" prefHeight="38.0" prefWidth="100.0" style="-fx-font-size: 14px;" styleClass="btn-delete" stylesheets="@../css/button-design.css" text="Eliminar" />
                    <Button onAction="#onClear" prefHeight="38.0" prefWidth="100.0" style="-fx-font-size: 14px;" styleClass="btn-clear" stylesheets="@../css/button-design.css" text="Limpiar" />
                </HBox>

                <Label fx:id="statusLabel" style="-fx-text-fill: #b00020; -fx-font-size: 13px;" wrapText="true" />
            <Button mnemonicParsing="false" onAction="#handleVolverDashboard" styleClass="btn-primary" stylesheets="@../css/button-design.css" text="Volver" />
            </VBox>
        </left>

        <center>
            <TableView fx:id="clienteTable" style="-fx-font-size: 14px;" styleClass="dashboard-table">
                <columns>
                    <TableColumn fx:id="dpiColumn" prefWidth="105.0" text="DPI" />
                    <TableColumn fx:id="firstNameColumn" prefWidth="100.0" text="Nombre" />
                    <TableColumn fx:id="lastNameColumn" prefWidth="120" text="Apellido" />
                    <TableColumn fx:id="phoneColumn" prefWidth="130.0" text="Teléfono" />
                    <TableColumn fx:id="emailColumn" prefWidth="140.0" text="Correo" />
               <TableColumn fx:id="idColumn" prefWidth="112.0" text="Id" />
                </columns>
                <BorderPane.margin>
                    <Insets bottom="15" left="0" right="15" top="15" />
                </BorderPane.margin>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </center>
    </BorderPane>

</Pane>
